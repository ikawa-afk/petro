    <!-- Bloco de Saldos com Contabilização Dinâmica -->
    <div class="relative my-1 bg-gradient-to-b from-[#0e2154]/85 to-[#071436]/90 border border-[#1b3473] rounded-2xl p-4 shadow-inner">
      <div class="flex flex-col items-center justify-center text-center space-y-3">
        <div class="relative flex flex-col items-center">
          <p class="text-xs text-[#90a3cf] font-medium mb-0.5">Saldo em Conta</p>
          
          <!-- Badge Flutuante de Ganho / Perda -->
          <div id="delta-badge" class="hidden absolute -top-4 z-20 items-center gap-0.5 text-xs font-black font-mono-numbers px-2 py-0.5 rounded-full shadow-lg animate-delta"></div>
          
          <h2 id="saldo-display" class="text-3xl sm:text-4xl font-black tracking-tight font-mono-numbers text-white transition-all duration-200">
            R$ 50,00
          </h2>
          <span id="contabilizando-aviso" class="hidden text-[10px] font-bold uppercase tracking-wider mt-0.5 text-emerald-400 animate-pulse">
            ▲ Contabilizando lucros...
          </span>
        </div>

        <div class="w-full bg-[#050f26]/80 border border-blue-900/40 rounded-xl py-2 px-3 flex items-center justify-between">
          <div class="text-left">
            <p class="text-[11px] text-[#8e86a0] font-medium leading-none">Lucro de Hoje</p>
            <h3 id="lucro-display" class="text-xl sm:text-2xl font-bold text-[#00e676] tracking-tight font-mono-numbers leading-tight mt-0.5">
              R$ 0,00
            </h3>
          </div>
          <div class="text-right">
            <span class="text-[11px] text-emerald-400 font-semibold block">99.4% assertivo</span>
            <p class="text-[10px] text-gray-400 font-medium">
              <span id="win-count" class="text-emerald-400 font-bold">0 WIN</span> /
