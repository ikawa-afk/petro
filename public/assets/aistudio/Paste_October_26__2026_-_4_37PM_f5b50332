      class="w-full relative overflow-hidden transition-all duration-200 text-white font-extrabold text-xs sm:text-sm py-3.5 px-4 rounded-xl flex items-center justify-center gap-2 shadow-lg cursor-pointer uppercase tracking-wide border border-emerald-400/40 bg-emerald-600 hover:bg-emerald-500 animate-pulse-button">
      <span id="btn-texto" class="font-extrabold tracking-wider text-white drop-shadow">
        ATIVAR INTELIGÊNCIA ARTIFICIAL
