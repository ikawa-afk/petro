<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>IA SHARKPRO</title>
  <!-- Google Fonts: Inter & JetBrains Mono -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>

  <style>
    body {
      font-family: 'Inter', sans-serif;
    }
    .font-mono-numbers {
      font-family: 'JetBrains Mono', monospace;
      font-variant-numeric: tabular-nums;
    }
    .bar {
      transition: height 0.4s ease, background-color 0.3s ease;
    }
    /* Animação do botão pulsante */
    @keyframes pulse-button {
      0%, 100% {
        transform: scale(1);
        box-shadow: 0 0 16px rgba(0, 230, 118, 0.45), 0 0 30px rgba(0, 230, 118, 0.2);
      }
      50% {
        transform: scale(1.025);
        box-shadow: 0 0 28px rgba(0, 230, 118, 0.85), 0 0 50px rgba(0, 230, 118, 0.4);
      }
    }
    .animate-pulse-button {
      animation: pulse-button 1.8s infinite ease-in-out;
    }
    @keyframes bounce-delta {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-4px); }
    }
    .animate-delta {
      animation: bounce-delta 0.6s ease-in-out infinite;
    }
  </style>
</head>
<body class="bg-[#03091e] text-white flex justify-center items-center min-h-screen p-2 sm:p-4 selection:bg-blue-600 selection:text-white relative overflow-x-hidden">

  <!-- Luzes ambiente ao fundo -->
  <div class="fixed top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[550px] h-[380px] bg-blue-600/20 rounded-full blur-[130px] pointer-events-none"></div>
  <div class="fixed bottom-10 left-1/2 -translate-x-1/2 w-[350px] h-[220px] bg-cyan-500/15 rounded-full blur-[110px] pointer-events-none"></div>

  <!-- Container Principal Mobile -->
  <main class="relative w-full max-w-[430px] bg-[#091538] border border-[#182e6d] rounded-2xl p-4 sm:p-5 shadow-2xl shadow-blue-950/60 flex flex-col gap-3.5 z-10 backdrop-blur-md">

    <!-- Topo / Cabeçalho -->
    <header class="flex flex-col items-center justify-center pt-1 pb-1">
      <div class="w-full flex items-center justify-between px-1 mb-2">
        <div class="flex items-center gap-1.5">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
          </span>
          <span id="badge-status" class="text-[10px] uppercase font-bold tracking-widest text-emerald-400 bg-emerald-950/60 border border-emerald-800/50 px-2 py-0.5 rounded-full">
            SISTEMA ONLINE
          </span>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="toggleAudio()" id="btn-audio" class="p-1.5 rounded-lg text-gray-300 hover:text-white bg-[#0d1d45]/70 border border-blue-900/40 text-xs">
            🔊
          </button>
          <button onclick="reiniciarSessao()" class="p-1.5 rounded-lg text-gray-300 hover:text-white bg-[#0d1d45]/70 border border-blue-900/40 text-xs">
            🔄
          </button>
        </div>
      </div>

      <div class="flex items-center gap-2.5">
        <!-- Ícone Tubarão / SharkPRO Tech Core -->
        <div class="relative flex items-center justify-center w-8 h-8 rounded-xl bg-gradient-to-tr from-blue-700 via-indigo-600 to-cyan-400 shadow-md shadow-blue-900/50">
          <svg class="w-5 h-5 text-white" viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2C12 2 13 8 18 12C20 13.6 22 14.5 22 17C22 19.5 19.5 20.5 17 20C14 19.4 11 18 8 18C5 18 3 19 2 20C3 17 6 15 8 14C10.5 12.7 11.5 9 12 2Z" />
          </svg>
        </div>
        <h1 class="text-xl sm:text-2xl font-black tracking-wider text-white">
          IA SHARK<span class="text-cyan-400">PRO</span>
        </h1>
      </div>
      <div class="inline-flex items-center gap-1.5 mt-1 px-2.5 py-0.5 rounded-full bg-emerald-950/70 border border-emerald-500/30">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-ping"></span>
        <span class="text-xs font-bold text-[#00e676] tracking-wide">Assertividade de 99%</span>
